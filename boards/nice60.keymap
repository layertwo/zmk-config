#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/reset.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    macros {
        mac_ent: mac_ent{
            label = "macro_enter_tog";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp RET>, <&macro_tap &tog 1>;
        };

        mac_lock: mac_lock{
            label = "macro_mac_lock";
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTL &kp LGUI &kp Q>
                     , <&macro_pause_for_release>
                     , <&macro_release &kp LCTL &kp LGUI &kp Q>
                     ;
        };
    };

    behaviors {
        gresc: grave_escape {
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            tapping-term-ms = <200>;
            #binding-cells = <0>;
            bindings = <&kp RCTRL>, <&mac_lock>;
        };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ------------------------------------------------------------------------------------------
// | ESC |  1  |  2  |  3  |  4  |  5  |  6  |  7  |  8  |  9  |  0  |  -  |  =  |   BKSP   |
// | TAB  |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  |  [  |  ]  |   "|"   |
// | TOG(1) |  A  |  S  |  D  |  F  |  G  |  H  |  J  |  K  |  L  |  ;  |  '  |     ENTER   |
// |  SHIFT  |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  |      SHIFT       |
// |  CTL  |  ALT  |  WIN |            SPACE              |  WIN  |  ALT  |  TOG(1) |  CTL  |
// ------------------------------------------------------------------------------------------
            bindings = <
    &gresc  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL  &kp BSPC
    &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLH
    &tog 1  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp SQT           &kp RET
    &kp LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH           &kp RSHFT
    &kp LCTRL &kp LALT &kp LGUI             &kp SPACE                     &kp RGUI  &kp RALT  &tog 1   &td0
            >;
        };

    nav_layer {
            bindings = <
    &tog 1  &kp F1  &kp F2 &kp F3   &kp F4    &kp F5 &kp F6   &kp F7   &kp F8   &kp F9    &kp F10  &kp F11 &kp F12   &trans
    &none   &tog 1  &none  &kp HOME &kp PG_UP &none  &none    &none    &none    &none     &none     &none   &none    &none
    &tog 1  &none   &none  &kp END  &kp PG_DN &none  &kp LEFT &kp DOWN &kp UP   &kp RIGHT &none     &none   &mac_ent
    &none           &none  &none    &none     &none  &none    &none    &none    &none     &none     &none   &none
    &none   &none   &none                        &trans                                   &none     &none      &none   &none
            >;
        };

    };
};
