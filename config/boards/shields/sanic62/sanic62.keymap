#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        bindings = <
&gresc      &kp N1     &kp N2       &kp N3     &kp N4    &kp N5                        &kp N6    &kp N7     &kp N8     &kp N9     &kp N0      &kp BKSP
&kp TAB     &kp Q      &kp W        &kp E      &kp R     &kp T                         &kp Y     &kp U      &kp I      &kp O      &kp P       &kp BSLH
&tog 1      &kp A      &kp S        &kp D      &kp F     &kp G                         &kp H     &kp J      &kp K      &kp L      &kp SCLN    &kp QUOT
&kp LSHFT   &kp Z      &kp X        &kp C      &kp V     &kp B                         &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH    &kp RSHFT
&kp LCTRL   &none      &none        &kp LALT   &kp LGUI  &kp SPC &kp DEL     &kp BKSP  &kp RET   &kp MINUS  &kp EQL    &kp LBKT   &kp RBKT    &kp RTCL
                        >;
                };
                nav_layer {
                        bindings = <
&tog 1      &kp F2     &kp F3       &kp F4     &kp F5    &kp F6                        &kp F7    &kp F8     &kp F9     &kp F10    &kp F11     &kp F12
&none       &tog 1     &none        &kp HOME   &kp PGUP  &none                         &none     &none      &cp M_PREV &cp M_NEXT &cp M_PLAY  &none
&tog 1      &none      &none        &kp END    &kp PGDN  &none                         &kp LARW  &kp DARW   &kp UARW   &kp RARW   &none       &none
&none       &none      &none        &none      &none     &none                         &none     &none      &none      &none      &none       &none
&bt BT_PRV  &bt BT_NXT &bt BT_SEL 0 &none      &none     &trans   &trans     &trans    &trans    &none      &none      &none      &none       &bt BT_CLR
                        >;
                };

        };
};
