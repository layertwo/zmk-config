#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


/ {
    macros {
        mac_ent: mac_ent{
            label = "macro_enter_tog";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp RET>, <&macro_tap &tog 1>;
        };

        mac_lock: mac_lock{
            label = "macro_mac_lock";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LCTL &kp LGUI &kp Q>;
        };
    };

    td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_0";
            tapping-term-ms = <200>;
            #binding-cells = <0>;
            bindings = <&kp RCTRL>, <&mac_lock>;
        };

    keymap {
        compatible = "zmk,keymap";

            default_layer {
                bindings = <
&gresc      &kp N1     &kp N2       &kp N3     &kp N4     &kp N5                        &kp N6    &kp N7     &kp N8     &kp N9     &kp N0     &kp BKSP
&kp TAB     &kp Q      &kp W        &kp E      &kp R      &kp T                         &kp Y     &kp U      &kp I      &kp O      &kp P      &kp BSLH
&tog 1      &kp A      &kp S        &kp D      &kp F      &kp G                         &kp H     &kp J      &kp K      &kp L      &kp SCLN   &kp QUOT
&kp LSHFT   &kp Z      &kp X        &kp C      &kp V      &kp B                         &kp N     &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp RSHFT
&kp LCTRL   &none      &none        &kp LALT   &kp LGUI   &kp SPC &kp DEL     &kp BKSP  &kp RET   &kp MINUS  &kp EQL    &kp LBKT   &kp RBKT   &td0
                        >;
                };
    nav_layer {
        bindings = <
&tog 1      &kp F2     &kp F3       &kp F4     &kp F5     &kp F6                        &kp F7    &kp F8     &kp F9     &kp F10    &kp F11    &trans
&none       &tog 1     &none        &kp HOME   &kp PG_UP  &none                         &none     &none      &cp C_PREV &cp C_NEXT &cp C_PP   &none
&tog 1      &none      &none        &kp END    &kp PG_DN  &none                         &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &none      &none
&none       &none      &none        &none      &none      &none                         &none     &none      &none      &none      &none      &none
&bt BT_PRV  &bt BT_NXT &bt BT_SEL 0 &none      &none      &trans    &trans     &trans   &mac_ent  &none      &none      &none      &none      &bt BT_CLR
                        >;
                };

        };
};
